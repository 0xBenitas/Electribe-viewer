# Caddy auto-provisions TLS for {$DOMAIN}. Serves the cockpit SPA and proxies the
# WebSocket session relay at /ws (the client connects to wss://DOMAIN/ws).

{$DOMAIN} {
	encode zstd gzip

	handle /ws* {
		reverse_proxy ws:8787
	}

	handle {
		root * /srv
		# Cache : accueil + worklets (non versionnés) revérifiés à chaque visite ;
		# bundles hachés /assets/* immuables (cf. DEPLOY.md, incident téléphone 2026-09-04).
		@fresh path / /index.html *.html /worklets/*
		header @fresh Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
